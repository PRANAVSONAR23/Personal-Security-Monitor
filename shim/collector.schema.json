{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psm.example/collector.schema.json",
  "title": "psm collector envelope (macOS shim v1)",
  "type": "object",
  "required": ["psm_collector", "version", "host", "taken_at", "modules", "gaps"],
  "additionalProperties": false,
  "properties": {
    "psm_collector": { "const": "macos" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "host": { "type": "string", "minLength": 1 },
    "taken_at": { "type": "string", "format": "date-time" },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "object" }
      },
      "properties": {
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "path"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "path": { "type": "string" },
              "source": {
                "type": "string",
                "enum": ["appstore", "system", "brew", "pkg", "sideload", "unknown"]
              }
            }
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["location", "name", "path"],
            "properties": {
              "location": {
                "type": "string",
                "enum": ["launchagent", "launchdaemon", "loginitem", "cron"]
              },
              "name": { "type": "string" },
              "path": { "type": "string" },
              "target": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "run_at_load": { "type": "boolean" },
              "enabled": { "type": ["boolean", "null"] }
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pkg", "permission", "granted"],
            "properties": {
              "pkg": { "type": "string" },
              "permission": { "type": "string" },
              "granted": { "type": "boolean" },
              "scope": { "type": "string", "enum": ["system", "user"] }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "size", "mtime"],
            "properties": {
              "path": { "type": "string" },
              "size": { "type": "integer", "minimum": 0 },
              "mtime": { "type": "string" },
              "sha256": { "type": ["string", "null"] },
              "executable": { "type": "boolean" },
              "signature_status": { "type": "string" },
              "skipped": { "type": "string" }
            }
          }
        },
        "processes": { "type": "array", "items": { "type": "object" } },
        "network": { "type": "array", "items": { "type": "object" } },
        "browser": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["browser", "id", "name"],
            "properties": {
              "browser": { "type": "string", "enum": ["chrome", "edge", "firefox", "safari"] },
              "profile": { "type": "string" },
              "id": { "type": "string" },
              "name": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "permissions": { "type": "array", "items": { "type": "string" } },
              "install_time": { "type": ["string", "null"] },
              "enabled": { "type": "boolean" }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "reason"],
        "properties": {
          "module": { "type": "string" },
          "reason": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
